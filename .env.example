# Copia este archivo como .env para desarrollo local (opcional).
# Sin definir nada, la app usa http://localhost:8080 contra el backend real.
#
# En GitHub Actions el valor se inyecta desde un Secret del repositorio
# (Settings → Secrets → Actions → VITE_API_URL), ver deploy.yml.
VITE_API_URL=http://localhost:8080

# true = modo demo sin backend (datos falsos en memoria, ver src/service/mocks.ts).
# La demo de GitHub Pages compila con true. En local dejalo en false o sin definir.
VITE_USE_MOCKS=false
